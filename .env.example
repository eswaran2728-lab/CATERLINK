# CaterLink — shares one Supabase project with VECTA (see MIGRATION-AUDIT.md).

# --- Supabase (single shared project with VECTA — same values as VECTA's .env.example) ---
NEXT_PUBLIC_SUPABASE_URL=https://zsxneokqulktgnccxgkz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Cross-app QR pass minting (mirrors VECTA's QR_TOKEN_SECRET-signed endpoint) ---
NEXT_PUBLIC_VECTA_API_BASE_URL=https://vecta-rho.vercel.app

# --- Auth provider selection (Phase 1-4 migration) ---
# "supabase" (default, or unset) keeps today's email/password sign-in and
# vendor self-registration. "firebase" swaps in Google Workspace sign-in
# (Phase 3+). Both vars must be set to the SAME value.
AUTH_PROVIDER=supabase
NEXT_PUBLIC_AUTH_PROVIDER=supabase

# --- Firebase (only needed once AUTH_PROVIDER=firebase — see AUTH-CONTRACT.md) ---
# Same Firebase project as VECTA (airasia-avsec-auth) — copy these values
# from VECTA's Firebase console config, not a separate project. Not
# secrets — safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Restricts the Google account picker to this Workspace domain (UX only —
# VECTA's /api/auth/sync-claims does the real, server-side check).
NEXT_PUBLIC_AVSEC_WORKSPACE_DOMAIN=

# SERVER ONLY. Firebase console -> Project settings -> Service accounts ->
# Generate new private key (the SAME key downloaded for VECTA — one
# Firebase project, set again here since env vars don't cross Vercel
# projects). Base64-encode before pasting — never commit the raw JSON:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
